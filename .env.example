SECRET_KEY=replace-with-random-secret
AUTH_SIGNING_KEY=replace-with-another-random-secret
SERVICE_KEY=replace-with-a-third-random-secret
DEBUG=0
DB_NAME=room_reservations
DB_USER=postgres
DB_PASS=replace-with-database-password
DB_HOST=db
DB_PORT=5432
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.test
DJANGO_SUPERUSER_PASSWORD=replace-with-admin-password
# Optional initial employee; leave both values empty to skip account creation.
DJANGO_EMPLOYEE_USERNAME=
DJANGO_EMPLOYEE_PASSWORD=
DJANGO_EMPLOYEE_EMAIL=
PGADMIN_EMAIL=admin@example.test
PGADMIN_PASSWORD=replace-with-pgadmin-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=rezerwacje@example.local
